# VSCode file settings
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/tasks.json

# Input elf and rom files
*.elf
*.z64

# Output C files
RecompiledFuncs/
RecompiledPatches/

# RE scratch: single-function extracts pulled out of RecompiledFuncs/ while
# reverse-engineering (see docs/re-notes/). Regenerable from the recompiler
# output, so they are kept local rather than committed.
hlp_*.c

# Linux build output
build*/
*.o

# Windows build output
*.exe
*.dll
*.lib
*.pdb

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

