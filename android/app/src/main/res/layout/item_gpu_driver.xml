<?xml version="1.0" encoding="utf-8"?>
<!--
    One selectable driver. The radio button is the row's identity (it lives in the
    RadioGroup and carries the selection); the Remove button is absent for the
    system-driver row, which cannot be deleted.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <RadioButton
        android:id="@+id/driverRadio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/driverRemoveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/driver_remove" />
</LinearLayout>
