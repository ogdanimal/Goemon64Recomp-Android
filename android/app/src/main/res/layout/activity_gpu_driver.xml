<?xml version="1.0" encoding="utf-8"?>
<!--
    Driver picker for user-supplied Vulkan drivers. Only present in a build made
    with -PcustomDriver=true; see GpuDriverActivity and the manifest.

    Deliberately its own screen with its own launcher icon rather than a row in
    the in-game settings menu: a driver that will not initialise takes the game
    down before any in-game UI exists, so a setting reachable only from inside
    the game would be unreachable in exactly the case it is needed.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/driver_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/driver_intro"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- What actually happened on the last launch. This is the part that makes
             "our bug or their driver?" answerable, so it stays above the list. -->
        <TextView
            android:id="@+id/driverStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#1FFFFFFF"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/copyReportButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/driver_copy_report" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/driver_list_heading"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Rows are added by GpuDriverActivity: one for the system driver, then
             one per imported driver. Not a RadioGroup — it only manages radio
             buttons that are its DIRECT children, and each row nests one inside a
             layout, so GpuDriverActivity owns the mutual exclusion instead. -->
        <LinearLayout
            android:id="@+id/driverList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/importDriverButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/driver_import" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/driver_footer"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
